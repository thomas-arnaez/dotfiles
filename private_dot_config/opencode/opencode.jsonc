{
  "$schema": "https://opencode.ai/config.json",

  // Do not silently change the policy underneath you.
  "autoupdate": "notify",
  "default_agent": "plan",

  "permissions": [
    // Fail closed for tools and plugin/MCP actions not explicitly listed.
    { "action": "*", "resource": "*", "effect": "deny" },

    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },

    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },

    // Optional: useful if you use Code Mode.
    { "action": "execute", "resource": "*", "effect": "allow" },

    // Allows the boundary check. Agent edit rules still decide read vs write.
    { "action": "external_directory", "resource": "~/dev/*", "effect": "allow" }
  ],

  "instructions": [.opencode/WORKTREE.md],

  "agents": {
    "plan": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },

        // Retains OpenCode's ability to write its own plan artifact.
        { "action": "edit", "resource": "~/.opencode/plan/*", "effect": "allow" },

        { "action": "shell", "resource": "*", "effect": "deny" },

        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "explore", "effect": "allow" }
      ]
    },

    "build": {
      "permissions": [
        // Build is read-only unless the trusted launcher overrides this.
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" },

        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "explore", "effect": "allow" }
      ]
    },

    "explore": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },

    "general": {
      "disabled": true
    }
  }
}
